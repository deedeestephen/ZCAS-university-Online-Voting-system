rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'THPN2wjznufJIaoWsmAf8dlvrCH3' ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'admin@zcas.edu.zm' || 
          request.auth.token.email.lower() == 'sikalundumwinga@gmail.com'
        )) ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    match /adminUsers/{uid} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid && (
        request.auth.uid == 'THPN2wjznufJIaoWsmAf8dlvrCH3' || 
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'admin@zcas.edu.zm' || 
          request.auth.token.email.lower() == 'sikalundumwinga@gmail.com'
        ))
      ) || isAdmin();
      allow delete: if false;
    }

    match /students/{uid} {
      allow get: if isSignedIn();
      allow list: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /candidates/{candidateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /votes/{voteId} {
      allow read: if isAdmin() || (isSignedIn() && existing().voterId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.voterId == request.auth.uid);
      allow create: if isSignedIn() && incoming().voterId == request.auth.uid;
      allow update: if isSignedIn() && existing().voterId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /receipts/{receiptId} {
      allow read, list: if isSignedIn() && resource.data.voterId == request.auth.uid;
      allow create: if isSignedIn() && incoming().voterId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
